# ========================================
# API Configuration
# ========================================
# Copia este archivo a .env y completa con tus credenciales reales

# ========================================
# BACKEND CREDENTIALS
# ========================================
# Estas variables NO tienen el prefijo REACT_APP_
# Solo son accesibles en el servidor Node.js (server.js)
N1CO_CLIENT_ID=your_client_id_here
N1CO_CLIENT_SECRET=your_client_secret_here

# ========================================
# BACKEND SECURITY
# ========================================
# API Key para autenticar peticiones desde el frontend
# Genera una clave segura: https://randomkeygen.com/
# Esta misma clave debe estar en REACT_APP_PROXY_API_KEY
PROXY_API_KEY=genera-una-clave-aleatoria-aqui-min-32-chars

# URL del frontend en producción (para CORS)
# Desarrollo: déjalo vacío (localhost permitido por defecto)
# Producción: https://tu-dominio.com
FRONTEND_URL=

#NODE_ENV=production
#PORT=3001


# ========================================
# FRONTEND PUBLIC VARIABLES
# ========================================
# Estas variables SÍ son accesibles en React (tienen REACT_APP_)

# Base URL de la API de N1co
REACT_APP_API_BASE_URL=https://api.h4b.dev/api/v3

# URL del servidor proxy
# Desarrollo: http://localhost:3001
# Producción: https://tu-backend.com
REACT_APP_API_PROXY_URL=http://localhost:3001

# API Key para el proxy (debe coincidir con PROXY_API_KEY del backend)
REACT_APP_PROXY_API_KEY=genera-una-clave-aleatoria-aqui-min-32-chars

# Lista de IDs de planes separados por comas (sin espacios)
# Puedes agregar o quitar planes según necesites
REACT_APP_PLAN_IDS=1807,1808,1809,1810

# Location Code
# Código de sucursal para las transacciones
REACT_APP_LOCATION_CODE=N1C0CD001
